[Unit]
Description=Football Team Backend (Green - Port 8081)
After=network.target

[Service]
User=root
WorkingDirectory=/opt/football-team
ExecStart=/usr/bin/java -Xms128m -Xmx512m -Dspring.profiles.active=dev -jar /opt/football-team/football-team.jar --server.port=8081
EnvironmentFile=/opt/football-team/env
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/football-team/green.log
StandardError=append:/var/log/football-team/green-error.log

[Install]
WantedBy=multi-user.target
